# Merge these settings into your local environment; never overwrite existing keys.
# This file is a template, not loaded automatically by the Python modules.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MAIN_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
# For another chat-completions-compatible endpoint: LLM_PROVIDER=compatible
LLM_BASE_URL=
LLM_API_KEY=

# Current runtime: local BM25 + exact cosine, not Qdrant network search.
RAG_SEARCH_BACKEND=local
RAG_CORPUS_PATH=runtime/points_cache.jsonl
EMBEDDING_MODEL=BAAI/bge-m3
MODEL_CACHE_DIR=tmp/models
RAG_ALLOW_MODEL_DOWNLOAD=0
RAG_CPU_THREADS=4
RAG_CANDIDATES=8

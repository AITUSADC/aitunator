# === Режим работы RAG (п. 1 ревью) ===
RAG_MODE=mock

# === SQLite и хранение (п. 2 ТЗ) ===
SQLITE_PATH=runtime/aitunator.db
SESSION_RETENTION_DAYS=30

# === Лимиты, таймауты и доверенный прокси (п. 6-7 ТЗ) ===
MAX_QUESTION_LENGTH=1000
RATE_LIMIT_PER_MINUTE=10
TRUSTED_PROXY_IPS=
TTFT_TIMEOUT_SECONDS=15
TOTAL_TIMEOUT_SECONDS=60

# === Qdrant и база знаний (п. 5 ТЗ) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb
KB_VERSION=metadata-v3

# === Модели и провайдеры (п. 3 ТЗ) ===
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAIN_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
EMBEDDER=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER=noop
RERANK_PROVIDER=noop
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
